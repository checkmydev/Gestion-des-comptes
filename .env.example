# Copier ce fichier en .env.local (jamais publié) et compléter.

# Supabase : Project Settings > API (URL du projet et clé « anon public »).
# La clé anon est publique par nature : la sécurité repose sur les règles RLS.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Uniquement pour scripts/push-prices.mjs (envoi des prix relevés depuis le PC) :
# le compte de Papa dans l'application.
SUPABASE_EMAIL=
SUPABASE_PASSWORD=
